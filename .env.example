# Application
PROJECT_NAME=Watchly
DEBUG=false

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=watchly

# JWT — generate with: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Seeded admin account (app/db/seed.py)
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@gmail.com
FIRST_ADMIN_FULL_NAME=Admin User
FIRST_ADMIN_PASSWORD=Admin@123

# --- Monitoring -----------------------------------------------------------
MONITORING_ENABLED=true
MONITOR_TICK_SECONDS=60
DEFAULT_CHECK_INTERVAL_SECONDS=300
DEFAULT_TIMEOUT_SECONDS=10
DEFAULT_MAX_DOWN_ALERTS=4

# --- Alerting -------------------------------------------------------------
ALERTS_ENABLED=true
ALERT_EMAIL_ENABLED=true
# Comma-separated; added to every alert on top of each website's own list.
ALERT_DEFAULT_EMAILS=devs@example.com
ALERT_DASHBOARD_URL=

# SMTP — any provider. AWS SES: email-smtp.<region>.amazonaws.com:587
#                      Resend:  smtp.resend.com:587 (username "resend")
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=alerts@yourdomain.com
SMTP_FROM_NAME=Watchly Alerts

# Optional extra channels — left blank they stay off.
SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=

# Slack — bot token and channel are set per project through the API.
# This webhook is an optional firehose for projects with no Slack of their own.
SLACK_WEBHOOK_URL=
# Encrypts stored Slack bot tokens. Defaults to SECRET_KEY when blank;
# changing either makes already-stored tokens unreadable.
SLACK_TOKEN_ENCRYPTION_KEY=
