# Application
PROJECT_NAME=Watchly
DEBUG=false

# Logs: one file per part of the backend (auth.log, monitoring_alerts.log, ...)
# plus access.log and errors.log, all in LOG_DIR. Under Docker Compose that is
# ./logs on the host. Files rotate at LOG_MAX_BYTES, keeping LOG_BACKUP_COUNT.
# LOG_LEVEL: DEBUG, INFO, WARNING or ERROR.
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Docker Compose published ports (docker compose up)
WEB_PORT=8080
API_PORT=8000

# PostgreSQL. Under Docker Compose the API ignores POSTGRES_HOST/PORT and
# talks to the "db" container; POSTGRES_PORT is still the port published on the host.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=watchly

# JWT — generate with: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# A session ends after this long unused; each refresh restarts the clock.
REFRESH_TOKEN_EXPIRE_DAYS=7
# The refresh cookie is HTTPS-only. Browsers make an exception for localhost;
# set false only to serve the app over plain HTTP on another host.
REFRESH_COOKIE_SECURE=true

# How long an emailed invitation link stays usable. Invitations are sent over the
# SMTP settings below and link to ALERT_DASHBOARD_URL, so both must be set.
INVITATION_EXPIRE_DAYS=7
# Expired invitations are deleted. Of the accepted and the revoked ones, only
# this many of each, the newest, are kept; older ones are deleted.
INVITATION_HISTORY_KEEP=50
# Account requests from the sign-in page: of the approved ones, only this many,
# the newest, are kept. Pending ones stay until an Admin or DevOps user answers
# them, and rejected ones are kept for good: a rejected address cannot ask again
# until an Admin or DevOps user unblocks it or invites it directly.
ACCOUNT_REQUEST_HISTORY_KEEP=50
# How long the link confirming a changed email address stays usable. Sent the
# same way as invitations, so it needs the same two settings.
EMAIL_CHANGE_EXPIRE_HOURS=24
# How long a temporary password from "forgot password" can be used to sign in.
# It is emailed over the same SMTP settings.
TEMP_PASSWORD_EXPIRE_MINUTES=60
# Wrong passwords in a row at sign-in before sign-in is locked for
# LOGIN_LOCKOUT_MINUTES. The lock lifts by itself, and a temporary password from
# "forgot password" still gets in meanwhile; python -m app.db.reactivate <username>
# lifts it early from the server.
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Rate limits on the endpoints that need no sign-in, per client (an IPv4
# address, or an IPv6 /64); past one they answer 429 with Retry-After. Each is
# `<requests>/<period>`: `10/minute`, `5/hour`, `20/15 minutes`.
RATE_LIMIT_ENABLED=true
# Sign-in attempts, right or wrong, to any account.
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_SIGNUP=5/hour
# Temporary passwords asked for, whichever addresses they go to.
RATE_LIMIT_FORGOT_PASSWORD=5/hour
# Tokens tried from emailed links: invitations and email-change confirmations.
RATE_LIMIT_EMAIL_LINKS=20/minute
# Accounts asked for from the sign-in page, whichever addresses they name: each
# new one emails every Admin and DevOps user.
RATE_LIMIT_ACCOUNT_REQUESTS=5/hour
# Proxies whose X-Forwarded-For uvicorn believes, so clients are told apart
# rather than all sharing the proxy's limit: addresses or networks, comma-
# separated. Unset, the Docker image trusts the web container's network, and
# uvicorn on the host trusts 127.0.0.1. uvicorn reads it from the environment,
# not this file, so on the host export it or pass --forwarded-allow-ips.
# FORWARDED_ALLOW_IPS=10.0.0.5

# --- Visitor country ------------------------------------------------------
# The header in which a proxy in front of Watchly (AWS WAF, CloudFront,
# Cloudflare) reports the visitor's two-letter country. Empty = feature off.
# The proxy must overwrite it and the API must not be reachable around the
# proxy, or anyone could send it. AWS WAF prefixes inserted headers with
# x-amzn-waf-; CloudFront: CloudFront-Viewer-Country; Cloudflare: CF-IPCountry.
# COUNTRY_HEADER=x-amzn-waf-client-country
# Only these countries may use the API (403 for the rest), or refuse these.
# Not both. Unknown countries are let through.
# COUNTRY_ALLOW=NP,IN
# COUNTRY_DENY=
# Email a user who signs in from a country they have not signed in from before.
COUNTRY_ALERT_NEW=true

# --- Monitoring -----------------------------------------------------------
MONITORING_ENABLED=true
MONITOR_TICK_SECONDS=60
DEFAULT_CHECK_INTERVAL_SECONDS=300
DEFAULT_TIMEOUT_SECONDS=10
DEFAULT_MAX_DOWN_ALERTS=4
# Days of raw checks kept (35 or more). Charts past that use hourly rollups.
CHECK_RETENTION_DAYS=90
# Seconds between a failed check and its retry (a site sets how many retries).
CHECK_RETRY_DELAY_SECONDS=5

# --- Alerting -------------------------------------------------------------
ALERTS_ENABLED=true
ALERT_EMAIL_ENABLED=true
# Comma-separated; added to every alert on top of each website's own list.
ALERT_DEFAULT_EMAILS=devs@example.com
ALERT_DASHBOARD_URL=
# The Watchly logo as a public HTTPS URL. Slack draws it above each alert and
# Telegram shows it as a small preview; they fetch it themselves, so a
# localhost URL will not do. Email embeds the logo and ignores this. Unset uses
# the copy on GitHub; set it blank to leave the logo out of Slack and Telegram.
# ALERT_LOGO_URL=https://watchly.example.com/watchly-logo.png

# SMTP — any provider. AWS SES: email-smtp.<region>.amazonaws.com:587
#                      Resend:  smtp.resend.com:587 (username "resend", password = API key)
# SMTP_FROM_EMAIL must be on a domain verified with your provider. Resend's
# onboarding@resend.dev test sender only delivers to the account owner's address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=alerts@yourdomain.com
SMTP_FROM_NAME=Watchly Alerts

# Optional extra channels — left blank they stay off.
ALERT_WEBHOOK_URL=

# Slack — bot token and channel are set per project through the API.
# This webhook is an optional firehose for projects with no Slack of their own.
SLACK_WEBHOOK_URL=
# Encrypts stored Slack, Telegram and WhatsApp tokens. Defaults to SECRET_KEY
# when blank; changing either makes already-stored tokens unreadable.
SLACK_TOKEN_ENCRYPTION_KEY=

# Telegram — like Slack, bot token (from @BotFather) and chat id are set per
# project through the API. These two together are an optional firehose for
# projects with no Telegram of their own.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp (Meta's WhatsApp Cloud API) — like Slack, the sender (a system
# user's access token and the business number's Phone number ID) and the
# numbers to alert are set per project through the API. These three together
# are an optional firehose for projects with no WhatsApp of their own.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Comma-separated, with country code: +8801712345678,+447700900123
WHATSAPP_RECIPIENTS=
# WhatsApp only delivers an approved template to someone who has not written
# to the business in 24 hours, so alerts are sent as this one. Create it in
# WhatsApp Manager with the text in app/monitoring/websites/README.md. Blank
# sends free-form text, which only reaches numbers inside that 24-hour window.
WHATSAPP_TEMPLATE_NAME=watchly_alert
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Site problems short of "down" ----------------------------------------
# Warn before an HTTPS certificate expires, once per threshold (days left).
SSL_CHECK_ENABLED=true
SSL_CHECK_INTERVAL_SECONDS=21600
CDN_CHECK_ENABLED=true
CDN_CHECK_INTERVAL_SECONDS=21600
# Where an HTTP site is served from: its address, the network that runs it
# (looked up over Team Cymru's DNS service, which is sent that address) and its
# reverse name. Also re-read whenever a new address answers.
SERVER_CHECK_ENABLED=true
SERVER_CHECK_INTERVAL_SECONDS=86400
SSL_EXPIRY_ALERT_DAYS=14,7
# Warn before a site's domain registration lapses, once per threshold (days
# left), looked up over RDAP (WHOIS for registries without it) once a day.
DOMAIN_CHECK_ENABLED=true
DOMAIN_CHECK_INTERVAL_SECONDS=86400
DOMAIN_EXPIRY_ALERT_DAYS=14,7
# A successful response slower than this counts as slow (a website can set its
# own). 0 turns slow alerts off. Alerts after N slow checks in a row, then
# stays quiet for the cooldown.
SLOW_RESPONSE_THRESHOLD_MS=3000
SLOW_RESPONSE_CHECKS=3
SLOW_ALERT_COOLDOWN_SECONDS=21600
# A ping check that loses at least this share (%) of its pings while the host
# still answers counts as lossy (a host can set its own). 0 turns packet-loss
# alerts off. Alerts after N lossy checks in a row, then stays quiet for the cooldown.
PACKET_LOSS_THRESHOLD_PERCENT=20
PACKET_LOSS_CHECKS=3
PACKET_LOSS_ALERT_COOLDOWN_SECONDS=21600

# --- Ping checks ------------------------------------------------------------
# Pings use unprivileged ICMP sockets, which Linux allows only to the groups in
# net.ipv4.ping_group_range (docker-compose.yml opens it for the API). Set true
# to use raw sockets instead, which need root or CAP_NET_RAW.
PING_PRIVILEGED=false

# --- DNS checks -------------------------------------------------------------
# The resolvers every DNS check asks at once, as Name=IP address (or a bare IP
# address), comma-separated. Each public one is its own network with its own
# caches, so together they show whether everyone is served the same records.
DNS_RESOLVERS=Cloudflare=1.1.1.1,Google=8.8.8.8,Quad9=9.9.9.9,OpenDNS=208.67.222.222

# --- Monthly uptime report --------------------------------------------------
# Sent on this day (1-28) and hour (UTC) for the month before. Which projects
# get it on which channel is set per project in the UI.
MONTHLY_REPORTS_ENABLED=true
MONTHLY_REPORT_DAY=1
MONTHLY_REPORT_HOUR_UTC=6
